{
  "name": "@glassfish-zero/desktop",
  "version": "0.2.0",
  "private": true,
  "description": "Glassfish Zero desktop app — the dashboard and its database, running on your own machine.",
  "author": "Zoli1212",
  "license": "MIT",
  "main": "src/main.js",
  "scripts": {
    "icon": "node scripts/make-icon.mjs",
    "prepare-server": "node scripts/stage-server.mjs",
    "start": "npm run prepare-server && electron .",
    "dist": "npm run prepare-server && electron-builder --win --publish never",
    "dist:dir": "npm run prepare-server && electron-builder --win --dir --publish never"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "^25.1.8"
  },
  "engines": {
    "node": ">=23.4"
  }
}
